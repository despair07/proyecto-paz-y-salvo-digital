PORT=3000

# Supabase PostgreSQL connection
# Supabase → Connect → Session pooler (puerto 5432)
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=your_db_password
DB_SSL=true
DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000

# JWT Configuration (generate a unique random value of at least 32 bytes)
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
JWT_EXPIRES_IN=24h

# Google OAuth: use the same OAuth 2.0 Web client ID as the frontend.
# Add http://localhost:5173 as an authorized JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_HOSTED_DOMAIN=uniautonoma.edu.co

# Solo desarrollo: login con correo y contraseña de los usuarios del seed. Dejar en false.
AUTH_PASSWORD_ENABLED=false
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000/api/v1
FRONTEND_PUBLIC_URL=http://localhost:5173

